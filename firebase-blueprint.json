{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user profile isolated to its owner or verified admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 320 },
        "displayName": { "type": "string", "maxLength": 120 },
        "photoURL": { "type": "string", "maxLength": 2048 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt", "updatedAt"]
    },
    "Thumbnail": {
      "title": "Thumbnail",
      "description": "Public gallery thumbnail item managed solely by verified admins",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "creator": { "type": "string", "maxLength": 120 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "niche": { "type": "string", "maxLength": 80 },
        "colors": { "type": "array" },
        "tags": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "imageUrl", "createdAt", "updatedAt"]
    },
    "CollectionBoard": {
      "title": "CollectionBoard",
      "description": "User-owned inspiration board of thumbnails",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "thumbnailIds": { "type": "array" },
        "colorTheme": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "name", "thumbnailIds", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private user profiles (read/write limited strictly to owner or verified admin)"
    },
    "/thumbnails/{thumbnailId}": {
      "schema": "Thumbnail",
      "description": "Public gallery catalog (public read, verified admin writes only)"
    },
    "/collections/{collectionId}": {
      "schema": "CollectionBoard",
      "description": "User-owned saved boards (read/list/write limited strictly to owner userId or verified admin)"
    }
  }
}
