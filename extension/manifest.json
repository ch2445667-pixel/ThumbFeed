{
  "manifest_version": 3,
  "name": "ThumbFeed - YouTube Thumbnail Grabber",
  "version": "1.0.0",
  "description": "1-Click HD YouTube Thumbnail grabber and inspiration collector for ThumbFeed.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grab Thumbnail for ThumbFeed"
  },
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
