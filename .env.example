# Gemini API (for AI tagging & extraction)
GEMINI_API_KEY=

# Cloudflare R2 Storage (S3-compatible, zero egress fees)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL: Your custom domain (e.g. https://cdn.yourdomain.com) OR Cloudflare R2.dev public subdomain (e.g. https://pub-xxxxxx.r2.dev)
R2_PUBLIC_URL=

# Supabase (Optional database / legacy storage fallback)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
